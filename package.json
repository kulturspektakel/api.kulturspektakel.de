    "@pothos/plugin-prisma": "^4.11.0",
    "@pothos/plugin-relay": "^4.6.2",
    "@pothos/plugin-scope-auth": "^4.1.6",
    "@prisma/client": "^6.16.2",
    "@sentry/node": "^8.48.0",
    "@sentry/tracing": "^7.120.4",
    "@types/basic-auth": "^1.1.8",
    "bandcamp-scraper": "^1.5.0",
    "basic-auth": "^2.0.1",
    "bignumber.js": "^9.3.1",
