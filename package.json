{
  "name": "api.kulturspektakel.de",
  "version": "1.0.0",
  "main": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "generate:prisma": "prisma generate",
    "generate:mail": "maizzle build --config ./src/maizzle/config.production.js",
    "generate:proto": "cd src/proto && protoc --experimental_allow_proto3_optional --plugin=../../node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=. ./*.proto --ts_proto_opt=esModuleInterop=true",
    "generate:env": "bun dotenv-vault pull",
    "update:db": "prisma db push",
    "mail": "maizzle serve --config ./src/maizzle/config.js",
    "update-interactive": "npx npm-check-updates --interactive --format group"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.51.0",
    "@jridgewell/resolve-uri": "^3.1.2",
    "@jridgewell/sourcemap-codec": "^1.5.5",
    "@maizzle/framework": "5.2.5",
    "@sentry/cli": "^2.55.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.merge": "^4.6.9",
    "@types/nodemailer": "^7.0.2",
    "@types/totp-generator": "^0.0.8",
    "bun-types": "latest",
    "fastq": "^1.19.1",
    "prettier": "^3.6.2",
    "prisma": "^6.16.2",
    "tailwindcss-email-variants": "^3.0.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.899.0",
